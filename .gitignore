# =============================================================
#  Godot 4 — Zen Garden project
# =============================================================

# Godot import cache, uid map, shader cache, etc.
# Regenerated automatically by the editor — never commit.
.godot/
.nomedia

# Compiled translation files (generated from .po sources)
*.translation

# Export presets — can contain Android signing key paths/passwords
.import/
export_presets.cfg
export_credentials.cfg

# =============================================================
#  OS / editor junk
# =============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VSCode workspace (machine-specific settings)
.vscode/

# Vim / Emacs swap files
*~
*.swp
*.swo

# Generic backups
*.bak
*.tmp
*.orig
*.import

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Keep development notes private; publish only README and asset credits.
*.md
!README.md
!CREDITS.md
docs/
art_src/
tests/*
!tests/potion_stress_smoke.gd
!tests/puzzle_session_smoke.gd
!tests/alchemical_rules_smoke.gd
!tests/alchemical_solver_audit.py
!tests/export_alchemical_boards.gd
!tests/run_puzzle_checks.ps1
!tests/ui_feedback_smoke.gd
!tests/puzzle_session_benchmark.gd
!tests/potion_checkpoint_smoke.gd

# Generated Android Gradle template; splash overrides live in android/splash/.
android/build/
android/.build_version

# Licensed Potion Sort item image sets: keep local, never publish to GitHub.
/games/potion_3/assets/items/set*/
